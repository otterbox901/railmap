# Sourced by the infra/azure scripts. Override any value from the environment.
: "${RG:=railmap-campaign}"
: "${LOCATION:=eastus}"
: "${VMSS:=railmap}"
: "${SKU:=Standard_ND96isr_H100_v5}"
: "${IMAGE:=microsoft-dsvm:ubuntu-hpc:2204:latest}"
: "${COUNT:=2}"
: "${PRIORITY:=Regular}"   # or Spot
: "${ADMIN:=azureuser}"
: "${SSH_PUB:=$HOME/.ssh/id_ed25519.pub}"
# Check current pricing for your region before running; used only for the confirmation prompt.
: "${PRICE_PER_VM_HOUR:=98}"
: "${HOURS:=3}"
: "${KEEP:=0}"             # 1: campaign.sh leaves the VMs running when it exits
STATE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.state"
